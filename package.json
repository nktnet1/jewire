{
  "name": "jewire",
  "author": "Khiet Tam Nguyen",
  "description": "Rewire private modules for use within Jest.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/jewire"
  },
  "version": "3.0.1",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "test": "jest",
    "tc": "jest --coverage",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "prepublishOnly": "pnpm build"
  },
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.cjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "meriyah": "^7.1.0",
    "rewire": "^9.0.1"
  },
  "keywords": [
    "jest",
    "rewire",
    "private",
    "hidden",
    "modules",
    "import",
    "unit",
    "test",
    "fake",
    "dependency",
    "mock",
    "require",
    "shim",
    "comp1531"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/rewire": "^2.5.30",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
