{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es5", "es2015", "esnext", "dom"],
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es6",
    "paths": {
      "meriyah/dist/types/estree": ["./node_modules/meriyah/dist/types/estree.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
